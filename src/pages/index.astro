  { file: '/media/featured/xue-tu-escape.png',       text: '雪兔逃亡', description: '进化论：牧狼人', bvid: 'BV1sYpm6vEAX', detail: '/films/evolution-wolf-herder' },
  { file: '/media/featured/you-sun-cultivation.png', text: '游隼修行', description: '进化论：牧狼人', bvid: 'BV1EjJ262EMW', detail: '/films/evolution-wolf-herder' },
  { file: '/media/featured/yu-xiang.png',            text: '雨巷',     description: '',                bvid: 'BV1WYpm6vEC4', detail: '/films/rain-alley' },
  { file: '/media/featured/shi-er-zhan.png',         text: '十二大战', description: '',                bvid: 'BV1bWpm6rEVC', detail: '/films/zodiac-war' },
];

// ── ②′ 流动画廊：固定封面清单，携带 B 站 embed + 详情页路由供点开播视频 ──
const featuredGalleryItems = FEATURED_COVERS.map((it) => ({
  image: it.file,
  text: it.text,
  description: it.description,
  alt: it.text,
  embed: toEmbed(`https://www.bilibili.com/video/${it.bvid}`),
  detailUrl: it.detail,
}));

