import ParticleText from '../components/react-bits/ParticleText.jsx';
import Lanyard from '../components/Lanyard.jsx';
import ProfileOperatorMerge from '../components/ProfileOperatorMerge.astro';
import GridMotion from '../components/react-bits/GridMotion.jsx';
import FeaturedGallery from '../components/FeaturedGallery.jsx';
import LightRays from '../components/react-bits/LightRays.jsx';
import LetterGlitch from '../components/react-bits/LetterGlitch.jsx';
import S3Stage from '../components/S3Stage';
import AiWorkflow from '../components/AiWorkflow.astro';
import { IDLE_VIDEO } from '../lib/sections';
import { getCollection } from 'astro:content';

const profile = (await getCollection('profile'))[0];

// ── ② 精选作品 · 流动画廊（FlexCarousel）──
//    固定 5 条：进化论：牧狼人（猫鹰对决 / 雪兔逃亡 / 游隼修行）→ 雨巷 → 十二大战。
//    竖屏封面（3:4）取自 AIGC 超短片资产库；点击卡片弹出对应 B 站成片。
//    三个进化论片段在标题下带说明「进化论：牧狼人」。

/** B 站视频页链接 → 播放器嵌入链接；无法识别时原样返回。 */
function toEmbed(url?: string): string {
  if (!url) return '';
  const bv = url.match(/(BV[0-9A-Za-z]{10})/);
  if (bv) return `https://player.bilibili.com/player.html?bvid=${bv[1]}&page=1&high_quality=1&danmaku=0`;
  return url;
}

