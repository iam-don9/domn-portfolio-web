---

<BaseLayout title="生成式剧场">
  <!-- ══ 首页 = 原生 scroll-snap 全屏 slide deck：每个组件占一屏 ══ -->
  <div class="deck">

    <!-- ══ Slide 1 · 英雄区（不改）══ -->
    <section class="slide hero-scene">
      <div class="stage" id="domn-stage" transition:persist aria-hidden="true">
        <div class="stage-frame">
          <canvas id="stage-canvas"></canvas>
          <div class="stage-fallback">
            <video data-index="0" src={IDLE_VIDEO} muted autoplay loop playsinline preload="auto" class="is-on"></video>
          </div>
        </div>
      </div>

      <div class="page-inner home">
        <div class="home-content">
          <div class="home-hero">
            <h1 class="sr-only">Dwell On My Nature</h1>
            <div class="home-title-visual" aria-hidden="true">
              <ParticleText
                client:load
                text={"DWELL\nON\nMY\nNATURE"}
                particleSize={3}
                density={5}
                color="#f4f5f7"
                highlightColor="#10b981"
                highlightMode="motion"
                shape="line"
                intro="none"
                scatter={120}
                gatherDuration={620}
                stagger={620}
                clickBurst
                burstStrength={0.8}
                pointerRepel={24}
                repelRadius={220}
                idleDrift={0}
                trigger="mount"
                fontFamily="var(--font-display)"
                fontSize="clamp(3.25rem, 8.4vw, 15rem)"
                fontWeight={400}
                letterSpacing={0.12}
                lineHeight={1.04}
                align="left"
                bleed={240}
                glow={false}
                className="home-particle"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="loopbar" id="domn-loopbar" transition:persist>
        <HomeLogoLoop client:load />
      </div>
    </section>

    <!-- ══ Slide 2 · 精选作品 · 弧形画廊（全宽，点开播 B 站成片）══ -->
    <section class="slide featured-slide" id="featured">
      <!-- S2 背景：LightRays 着色器光束（品牌青绿，跟随光标 / 点击脉冲），纯装饰不拦截交互 -->
      <div class="featured-bg" aria-hidden="true">
        <LightRays
          client:load
          raysOrigin="top-center"
          raysColor="#00B894"
          raysSpeed={1}
          lightSpread={0.6}
          rayLength={3}
          rayDensity={1.1}
          glow={0.7}
          haze={0.3}
          atmosphere={1}
          intensity={1}
          followMouse={true}
          mouseInfluence={0.12}
          cursorShadow={false}
          clickPulse={true}
          opacity={1}
        />
      </div>
      <!-- 屏头：居中限宽，与全站屏头一致 -->
      <div class="featured-head">
        <header class="slide-head">
          <div class="slide-head__t">
            <p class="slide-eyebrow">FEATURED</p>
            <h2 class="slide-title">精选作品</h2>
          </div>
        </header>
        <a class="featured-more" href="/films">
          <span>更多作品</span>
          <svg class="featured-more__arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h9M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
      <!-- 画廊：全宽铺满屏头以下剩余空间 -->
      <div class="featured-gallery">
        <FeaturedGallery client:load items={featuredGalleryItems} />
      </div>
    </section>

    <!-- ══ Slide 3 · 自研 skill（多分类文件夹：封面卡片 + 点击弹窗）══ -->
    <section class="slide skill-slide" id="skills">
      <!-- S3 背景层：LetterGlitch 字符故障着色器（字符在纯黑底上闪烁/流动） -->
      <div class="skill-bg" aria-hidden="true">
        <LetterGlitch
          client:load
          glitchColors={['#ffffff', '#00B894']}
          baseColor="#ffffff"
          backgroundColor="#000000"
          fontSize={14}
          density={0.9}
          baseOpacity={0.16}
          glitchAmount={0.45}
          speed={0.9}
          flow={0.5}
          centerFade={0.55}
          edgeFade={0.12}
          interactive={true}
          clickEffect="tear"
        />
      </div>
      <div class="slide-inner skill-inner">
        <header class="slide-head">
          <div class="slide-head__t">
            <p class="slide-eyebrow">MY SKILLS</p>
            <h2 class="slide-title">自研技能</h2>
          </div>
        </header>
        <S3Stage categories={skillCategories} client:load />
      </div>
    </section>

    <!-- ══ Slide 4 · 个人 AI 视频创作工作流（流线型，以雨巷为例）══ -->
    <AiWorkflow />

    <!-- ══ Slide 5 · 个人简介 hero + 画廊背景（画廊作装饰）══ -->
