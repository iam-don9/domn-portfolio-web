  <script>
    (function () {
      const el = document.querySelector('.hero-typed');
      if (!el) return;
      let tags;
      try { tags = JSON.parse(el.getAttribute('data-tags') || '[]'); } catch { tags = []; }
      if (!tags.length) return;

      const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) { el.textContent = tags[0]; return; }

      // Stable field：预留最宽标签宽度，打字时框不再伸缩（消除 CLS / 抖动）
      const box = el.closest('.hero-tagbox');
      function reserveWidth() {
        if (!box) return;
        const cs = getComputedStyle(el);
        const probe = document.createElement('span');
        probe.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;';
        probe.style.fontFamily = cs.fontFamily;
        probe.style.fontSize = cs.fontSize;
        probe.style.fontWeight = cs.fontWeight;
        probe.style.fontStyle = cs.fontStyle;
        probe.style.letterSpacing = cs.letterSpacing;
        document.body.appendChild(probe);
        let max = 0;
        tags.forEach((t) => { probe.textContent = t; max = Math.max(max, probe.offsetWidth); });
        probe.remove();
        if (max) box.style.minWidth = (max + 28) + 'px';
      }
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(reserveWidth);
      else reserveWidth();

      // 拟人节奏：基础速度带轻微抖动，每打几字“想一下”，删字更快，落定后停一会
      const TYPE_MIN = 52, TYPE_MAX = 96, DEL_MIN = 24, DEL_MAX = 46, HOLD = 1450, GAP = 240, THINK = 230;
      let ti = 0, ci = 0, deleting = false;
      const rand = (a, b) => a + Math.random() * (b - a);
      function tick() {
        const cur = tags[ti];
        if (!deleting) {
          ci++;
          el.textContent = cur.slice(0, ci);
          if (ci >= cur.length) {
            deleting = true;
            return setTimeout(tick, HOLD);
          }
          const pause = (ci % 4 === 0) ? THINK : 0;
          return setTimeout(tick, rand(TYPE_MIN, TYPE_MAX) + pause);
        }
        ci--;
        el.textContent = cur.slice(0, ci);
        if (ci <= 0) { deleting = false; ti = (ti + 1) % tags.length; return setTimeout(tick, GAP); }
        return setTimeout(tick, rand(DEL_MIN, DEL_MAX));
      }
      tick();
    })();
  </script>

  <script>
    const resumeModal = document.querySelector('[data-resume-modal]');
    const resumeOpeners = document.querySelectorAll('[data-resume-open]');
    const resumeClosers = document.querySelectorAll('[data-resume-close]');
    let resumeLastFocus = null;

    if (resumeModal instanceof HTMLElement) {
      const openResume = () => {
        resumeLastFocus = document.activeElement;
        resumeModal.hidden = false;
        resumeModal.setAttribute('aria-hidden', 'false');
        document.documentElement.classList.add('resume-modal-open');
        requestAnimationFrame(() => {
          resumeModal.classList.add('is-open');
          requestAnimationFrame(() => {
            if (resumeModal.classList.contains('is-open')) {
              resumeModal.querySelector('.resume-modal__close')?.focus();
            }
          });
        });
      };

      const closeResume = () => {
        resumeModal.classList.remove('is-open');
        resumeModal.setAttribute('aria-hidden', 'true');
        document.documentElement.classList.remove('resume-modal-open');
        window.setTimeout(() => { resumeModal.hidden = true; }, 220);
        if (resumeLastFocus instanceof HTMLElement) resumeLastFocus.focus();
      };

      resumeOpeners.forEach((opener) => opener.addEventListener('click', openResume));
      resumeClosers.forEach((closer) => closer.addEventListener('click', closeResume));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && resumeModal.classList.contains('is-open')) closeResume();
      });
    }
  </script>
</BaseLayout>

