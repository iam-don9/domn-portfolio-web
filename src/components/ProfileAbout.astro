---
// S6 左栏 · 个人简历。先给定位，再给业务能力、软能力与工具证据。
const abilityGroups = [
  {
    label: '业务能力',
    items: [
      {
        title: '项目管理',
        body: '从建筑智能化设计转向内容创作，习惯先拆需求、排计划、控节点，保证复杂项目按目标交付。',
      },
      {
        title: '独立交付',
        body: '独立完成剧本、分镜、角色与场景资产、生成、剪辑、调色、声音和宣发，把想法推进到成片。',
      },
      {
        title: '后期制作',
        body: '有自媒体创作与运营经验，使用 DaVinci Resolve 与 Premiere 剪辑调色；用 riser、whoosh、hit 等氛围音效修饰电影感。',
      },
      {
        title: '分镜与镜头设计',
        body: '关注视听语言、景别、构图、运镜、画风与材质，让每个镜头服务叙事和画面观感。',
      },
      {
        title: '角色 / 场景一致性',
        body: '重视资产图质量，先锁定角色、场景和风格约束，再进入镜头生成，减少跨镜头漂移。',
      },
      {
        title: '成本与效率优化',
        body: '按镜头目标选择模型；简单动作或空镜交给低消耗模型，并用 AI 辅助提示词、人工校验减少无效抽卡。',
      },
    ],
  },
  {
    label: '软能力',
    items: [
      {
        title: '审美',
        body: '长期接触影视、音乐、摄影、游戏和动漫，把视觉判断用于画面设计、节奏和材质选择。',
      },
      {
        title: '跨方协同',
        body: '擅长跨部门、跨单位沟通，统筹需求、资源和进度，让不同角色对交付目标保持一致。',
      },
      {
        title: '问题解决',
        body: '遇到问题先调研和验证，再形成可复用的方法论，把稳定的工作流沉淀为 skill 或工作台。',
      },
    ],
  },
];
const tools = [
  { cat: '创作工具', items: '即梦、Libtv、ComfyUI' },
  { cat: '编程工具', items: 'Codex、Claude Code、Gemini、WorkBuddy、Trae' },
  { cat: '后期工具', items: 'DaVinci Resolve、Premiere' },
];
const models = [
  { cat: '视频模型', items: 'Seedance、Minimax、Omini、Veo' },
  { cat: '生图模型', items: 'GPT Image、Midjourney、Nano Banana' },
];
---

<section class="profile reveal" id="about-profile">
  <div class="pf-block">
    <p class="pf-label">ABOUT ME</p>

    <div class="pf-identity">
      <h3 class="pf-name">Domn / 庄业东</h3>
      <p class="pf-role">AI 电影感视频导演 / AIGC 创意内容设计</p>
    </div>

    <p class="pf-about-lede">用工程思维，把 AI 变成可控的创意生产力。<br /><span class="pf-about-lede__accent">让创意能落地、能复用、能稳定交付。</span></p>
  </div>

  <div class="pf-block pf-abilities">
    {abilityGroups.map((group) => (
      <section class="pf-ability-group">
        <p class="pf-ability-group__label">{group.label}</p>
        <div class="pf-skills">
          {group.items.map((item) => (
            <article class="pf-skill">
              <h4 class="pf-skill__title">{item.title}</h4>
              <p class="pf-skill__body">{item.body}</p>
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="pf-block pf-foot">
    <div class="pf-foot-col">
      <p class="pf-label">COMMON TOOLS</p>
      <ul class="pf-tools">
        {tools.map((s) => (
          <li class="pf-tool">
            <span class="pf-tool__cat">{s.cat}</span>
            <span class="pf-tool__items">{s.items}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="pf-foot-col">
      <p class="pf-label">COMMON MODELS</p>
      <ul class="pf-models">
        {models.map((s) => (
          <li class="pf-model">
            <span class="pf-tool__cat">{s.cat}</span>
            <span class="pf-tool__items">{s.items}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .profile {
    position: relative;
    margin: 0;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding-left: 1.1rem;
  }
  .profile::before {
    content: '';
    position: absolute;
    left: 0; top: .35rem; bottom: .5rem;
    width: 2px;
    background: linear-gradient(180deg, var(--accent) 0%, var(--accent) 40%, transparent 100%);
  }
  .pf-block { margin: 0 0 clamp(.85rem, 1.7vh, 1.2rem); }
  .pf-block:last-child { margin-bottom: 0; }
  .pf-label {
    margin: 0 0 .45rem;
    font-family: Arial, "AlimamaFangYuanTi", sans-serif;
    font-size: clamp(.68rem, min(.72vw, 1.4vh), 1rem);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }
  .pf-identity {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: .45rem .8rem;
    margin: 0 0 .7rem;
  }
  .pf-name {
    margin: 0;
    font-family: var(--font-cn-head);
    font-size: clamp(1.15rem, min(1.7vw, 2.6vh), 2rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--text-primary);
  }
  .pf-role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: .68rem;
    letter-spacing: .06em;
    color: var(--accent-strong);
  }
  .pf-about-lede {
    max-width: 65ch;
    margin: 0;
    font-family: var(--font-cn-head);
    color: var(--text-primary);
    font-size: clamp(1rem, min(1.5vw, 2.4vh), 2.2rem);
    line-height: 1.3;
    text-wrap: balance;
  }
  .pf-about-lede__accent { color: var(--accent-strong); }
  .pf-abilities { display: flex; flex-direction: column; gap: clamp(.95rem, 1.7vh, 1.25rem); }
  .pf-ability-group { min-width: 0; }
  .pf-ability-group__label {
    margin: 0 0 .55rem;
    font-family: var(--font-mono);
    font-size: clamp(.68rem, min(.72vw, 1.4vh), 1rem);
    letter-spacing: .06em;
    color: var(--accent-strong);
  }
  .pf-skills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: .8rem clamp(.8rem, 1.6vw, 1.4rem);
  }
  .pf-skill {
    min-width: 0;
    padding-top: .65rem;
    border-top: 1px solid var(--border-soft);
  }
  .pf-skill__title {
    margin: 0;
    color: var(--text-primary);
    font-size: clamp(.82rem, min(1vw, 1.7vh), 1.15rem);
    font-weight: 600;
    line-height: 1.3;
  }
  .pf-skill__body {
    margin: .25rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(.76rem, min(.92vw, 1.55vh), 1.1rem);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .pf-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(.8rem, 1.6vw, 1.4rem);
    margin-bottom: 0;
    padding-top: .8rem;
    border-top: 1px solid var(--border-soft);
  }
  .pf-foot-col { min-width: 0; }
  .pf-tools, .pf-models {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: .32rem;
  }
  .pf-tool, .pf-model { display: flex; flex-direction: row; align-items: baseline; gap: .35rem; }
  .pf-tool__cat {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: clamp(.62rem, min(.8vw, 1.4vh), .9rem);
    letter-spacing: .04em;
    color: var(--accent-strong);
    text-transform: uppercase;
  }
  .pf-tool__items {
    font-family: Arial, "AlimamaFangYuanTi", sans-serif;
    font-size: clamp(.68rem, min(.9vw, 1.6vh), 1rem);
    line-height: 1.3;
    color: var(--text-muted);
  }
  @media (max-width: 860px) {
    .profile { min-height: auto; padding-left: 0; }
    .profile::before { display: none; }
    .pf-foot { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .pf-skills { grid-template-columns: 1fr; gap: .7rem; }
    .pf-foot { grid-template-columns: 1fr; gap: .9rem; }
    .pf-tool, .pf-model { flex-direction: column; gap: .1rem; }
  }
</style>
