---
/*
 * S6 · 个人简历（02 号屏）
 * 新版面逻辑：先上下结构，再左右结构。
 * 上部分 = 标题（个人简历）+ 主 Slogan + 名称；
 * 下部分 = 左右双栏：左=能力正文(ProfileAbout)，右=履历、跨域说明与交付证据卡。
 */
import ProfileAbout from './ProfileAbout.astro';
import ProfileEdgeCards from './ProfileEdgeCards.jsx';
---

<section class="slide merge-slide" id="about-merge">
  <div class="mg-inner reveal">
    <!-- 上部分：屏头 + Slogan + 名称（统一系统，去序号） -->
    <header class="mg-head">
      <div class="mg-head__t">
        <p class="slide-eyebrow">PROFILE · RESUME</p>
      </div>
    </header>

    <!-- 下部分：左右双栏 -->
    <div class="mg-body">
      <div class="mg-left">
        <ProfileAbout />
      </div>
      <div class="mg-right">
        <!-- 右栏上方：工作经历 -->
        <div class="mg-exp">
          <p class="mg-exp__label">EXPERIENCE</p>
          <ul class="mg-exp__list">
            <li>
              <span class="org">深圳达实智能｜上市系统集成商</span>
              <span class="role">售前解决方案负责人 · 智慧园区全流程项目管控</span>
            </li>
            <li>
              <span class="org">深圳欧博设计院｜甲级设计院</span>
              <span class="role">智能化专业负责人 / 项目负责人 · 20+ 大型项目设计统筹</span>
            </li>
          </ul>
          <p class="mg-exp__note">代表项目：深圳国际会展中心，获深圳市优秀勘察设计奖。</p>
        </div>
        <div class="mg-transition">
          <p class="mg-exp__label">CROSS-DOMAIN MOVE</p>
          <div class="mg-transition__list">
            <div class="mg-transition__item">
              <strong>现实原因</strong>
              <p>建筑行业的结构性变化让我重新选择长期方向，也促使我把业余时间里积累的 AI 视频能力转成正式职业能力。</p>
            </div>
            <div class="mg-transition__item">
              <strong>个人原因</strong>
              <p>我一直更希望从事内容创作。AI 降低了视频制作的门槛，让创意和审美可以被我亲手编织成画面。</p>
            </div>
            <div class="mg-transition__item">
              <strong>能力证据</strong>
              <p>我曾担任大型项目专业负责人、项目负责人，在深圳国际会展中心担任建筑智能化专业设计负责人，并获得深圳市优秀勘察设计奖。我希望被看见的是这套工作能力，以及它在新行业里的迁移价值。</p>
            </div>
          </div>
        </div>
        <!-- 右栏下方：4 张 4:3 交付证据卡 -->
        <div class="mg-cards">
          <ProfileEdgeCards client:load />
        </div>
        <p class="mg-closing">AI 视频不是抽卡，是导演决策加技术迭代。我希望把稳定的工程交付，转化成有想象力的视觉内容。</p>
      </div>
    </div>
  </div>
</section>

<style>
  .merge-slide {
    position: relative;
    height: 100dvh;                    /* 整页竖向滑页，严格满屏（一屏=一板块） */
    min-height: 100dvh;
    overflow: hidden;                  /* 面板本身只一屏；内容超出在 .mg-inner / .mg-left 内部滚动 */
    display: flex;
    flex-direction: column;
    background: transparent;           /* 透出底层生成式氛围层 */
  }
  .mg-inner {
    position: relative;
    flex: 1; min-height: 0;
    width: min(94vw, 100%);
    max-width: none;
    margin-inline: auto;
    display: flex; flex-direction: column;
    padding: calc(var(--topbar-h) + clamp(0.8rem, 2vh, 1.6rem)) clamp(1.5rem, 3vw, 6rem) clamp(1.2rem, 3vh, 2.2rem);
  }

  /* ── 上部分：标题 + Slogan + 名称（左右错落，制造不对称负空间）── */
  .mg-head {
    flex: 0 0 auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(1.2rem, 4vw, 3rem);
    padding-bottom: clamp(0.55rem, 1.2vh, 0.95rem);
    border-bottom: 1px solid var(--border-soft);
  }
  .mg-head__t { flex: 0 0 auto; margin: 0; }

  /* ── 下部分：左右双栏 ── */
  .mg-body {
    flex: 1; min-height: 0;
    display: grid;
    grid-template-columns:
      minmax(0, 1.18fr)
      minmax(clamp(520px, 26vw, 920px), .82fr);
    column-gap: clamp(1.5rem, 4vw, 7rem);
    margin-top: clamp(0.6rem, 1.4vh, 1rem);
  }
  /* 左栏：文案若超出网格高度，仅在内栏滚动，整页仍锁 100dvh，不裁切、不溢出 */
  .mg-left {
    min-width: 0;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
    border-right: 1px solid var(--border-soft);
    padding-right: clamp(1rem, 2.5vw, 2.2rem);
  }
  .mg-left::-webkit-scrollbar { width: 0; height: 0; display: none; }

  /* 右栏：上=工作经历，中=跨域说明，下=4 张 4:3 交付证据卡 */
  .mg-right {
    min-width: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(.6rem, 1.6vh, 1.1rem);
  }
  /* ── 右栏上方：工作经历 ── */
  .mg-exp {
    flex: 0 0 auto;
    padding-bottom: clamp(.5rem, 1.2vh, .9rem);
    border-bottom: 1px solid var(--border-soft);
  }
  .mg-exp__label {
    font-family: var(--font-mono);
    font-size: clamp(.68rem, min(.72vw, 1.4vh), 1rem);
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--accent-strong);
    margin: 0 0 .45rem;
  }
  .mg-exp__list {
    list-style: none; margin: 0 0 .5rem; padding: 0 0 0 .9rem;
    position: relative;
  }
  .mg-exp__list::before {
    content: ''; position: absolute; left: 0; top: .3rem; bottom: .3rem;
    width: 1px; background: var(--border);
  }
  .mg-exp__list li { position: relative; padding: 0 0 clamp(.3rem, .7vh, .5rem); }
  .mg-exp__list li:last-child { padding-bottom: 0; }
  .mg-exp__list li::before {
    content: ''; position: absolute; left: -.9rem; top: .5rem;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--accent-strong); transform: translateX(-2px);
  }
  .org { display: block; font-weight: 600; font-size: clamp(.82rem, min(1.2vw, 1.8vh), 1.4rem); color: var(--text-primary); line-height: 1.3; }
  .role { display: block; margin-top: .1rem; color: var(--text-secondary); font-size: clamp(.72rem, min(1vw, 1.55vh), 1.15rem); line-height: 1.35; }
  .mg-exp__note {
    color: var(--text-secondary); font-size: clamp(.72rem, min(1vw, 1.6vh), 1.25rem); line-height: 1.55;
    margin: 0; padding-left: .9rem; border-left: 1px solid var(--border-soft);
  }

  .mg-transition {
    flex: 0 0 auto;
    padding-bottom: clamp(.5rem, 1.2vh, .9rem);
    border-bottom: 1px solid var(--border-soft);
  }
  .mg-transition__list { display: grid; gap: clamp(.45rem, .9vh, .7rem); }
  .mg-transition__item {
    padding-left: .8rem;
    border-left: 1px solid var(--accent-dim);
  }
  .mg-transition__item strong {
    display: block;
    color: var(--text-primary);
    font-size: clamp(.76rem, min(.95vw, 1.5vh), 1.05rem);
    line-height: 1.3;
  }
  .mg-transition__item p {
    margin: .18rem 0 0;
    color: var(--text-secondary);
    font-size: clamp(.7rem, min(.88vw, 1.4vh), 1rem);
    line-height: 1.48;
    text-wrap: pretty;
  }

  /* ── 右栏下方：卡片网格区（内容驱动，不再填满整屏）── */
  .mg-cards {
    flex: 1 1 0;
    min-height: 0;
    display: flex;
    width: 100%;
  }
  .mg-cards :global(.pec-grid) {
    flex: 1 1 auto;
    min-height: 0;
    height: 100%;
    grid-template-rows: repeat(2, minmax(0, 1fr));
  }
  .mg-cards :global(.pec-cell) {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }
  .mg-closing {
    flex: 0 0 auto;
    margin: 0;
    padding-top: clamp(.6rem, 1.2vh, .9rem);
    border-top: 1px solid var(--border-soft);
    color: var(--accent-strong);
    font-family: var(--font-cn-head);
    font-size: clamp(.78rem, min(1vw, 1.55vh), 1.15rem);
    line-height: 1.42;
    text-wrap: pretty;
  }

  /* ── 窄屏：上下堆叠 ── */
  @media (max-width: 860px) {
    .merge-slide { height: auto; min-height: 100dvh; overflow: visible; }
    .mg-inner { overflow-y: visible; }
    .mg-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }
    .mg-body {
      grid-template-columns: 1fr;
      row-gap: 1.6rem;
    }
    .mg-left {
      border-right: none;
      padding-right: 0;
      overflow-y: visible;
    }
    .mg-right { gap: 1.1rem; }
    .mg-exp { padding-bottom: .8rem; }
    .mg-cards {
      display: block;
      flex: 0 0 auto;
    }
    .mg-cards :global(.pec-grid) {
      display: grid;
      flex: none;
      height: auto;
      grid-template-columns: 1fr !important;
      grid-template-rows: none !important;
      grid-auto-rows: minmax(0, auto);
    }
    .mg-cards :global(.pec-cell) {
      width: min(100%, 300px);
      height: auto;
      max-width: 300px;
      aspect-ratio: 4 / 3;
      margin-inline: auto;
      align-self: stretch;
      justify-self: stretch;
    }
  }

  /* 短屏桌面：减少重复留白，让简历正文在弹窗内一次读完。 */
  @media (max-height: 820px) and (min-width: 861px) {
    .mg-inner {
      padding-top: .8rem;
      padding-bottom: .8rem;
    }
    .mg-head { padding-bottom: .35rem; }
    .mg-body { margin-top: .45rem; }
    .mg-right { gap: .45rem; }
    .mg-exp,
    .mg-transition { padding-bottom: .4rem; }
    .mg-transition__list { gap: .3rem; }
    .mg-transition__item p { line-height: 1.34; }
    .mg-exp__label,
    .pf-ability-group__label { margin-bottom: .3rem; }
    .mg-exp__list { margin-bottom: .25rem; }
    .org { font-size: clamp(.74rem, min(1vw, 1.5vh), 1.2rem); }
    .role,
    .mg-exp__note { font-size: clamp(.64rem, min(.85vw, 1.2vh), 1rem); line-height: 1.28; }
    .mg-transition__item strong { font-size: clamp(.7rem, min(.85vw, 1.2vh), .95rem); }
    .mg-transition__item p { font-size: clamp(.62rem, min(.78vw, 1.1vh), .9rem); line-height: 1.22; }
    .mg-cards :global(.pec-cell) { aspect-ratio: 2 / 1; }
    .mg-left :global(.pf-abilities) {
      display: grid;
      grid-template-columns: minmax(0, 1.45fr) minmax(0, .8fr);
      gap: .7rem;
      align-items: start;
    }
    .mg-left :global(.pf-abilities .pf-ability-group) { min-width: 0; }
    .mg-left :global(.pf-abilities .pf-skills) { gap: .45rem clamp(.5rem, 1vw, .8rem); }
    .mg-left :global(.pf-abilities .pf-skill) { padding-top: .45rem; }
    .mg-left :global(.pf-abilities .pf-skill__body) { line-height: 1.28; }
    .mg-left :global(.pf-block) { margin-bottom: .65rem; }
    .mg-left :global(.pf-about-lede) {
      font-size: clamp(.88rem, min(1.2vw, 1.65vh), 1.5rem);
      line-height: 1.3;
    }
    .mg-left :global(.pf-foot) { padding-top: .55rem; }
    .mg-left :global(.pf-tools),
    .mg-left :global(.pf-models) { gap: .2rem; }
  }
</style>
