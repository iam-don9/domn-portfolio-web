---
// 作品放映区 + 制作步骤拆解表。
// films 详情页与世界观（角色设计）详情页共用——两边数据字段相同。
//
// 多视频切换：当项目存在多条可播放视频（成品区片段 / 原片）时，
// 放映区改为「单播放位 + 可切换标签页」形式——点击标签在唯一 iframe 内切换 B 站视频；
// 待上传片段显示为禁用态标签（显「待上传」）。单视频项目保持原有单播放位，不渲染标签条。
import type { CollectionEntry } from 'astro:content';
import { coverOf, mediaUrl } from '../lib/projects';

interface Playable {
  id: string;
  label: string;
  kind: 'final' | 'raw';
  embed: string | null;
  thumb: string | null;
  ready: boolean;
}

interface Props {
  project: CollectionEntry<'projects'>;
  /** 是否渲染「制作步骤拆解」表。新结构下拆解由制作过程组件承担，故关掉。 */
  showShots?: boolean;
}
const { project, showShots = true } = Astro.props;
const d = project.data;

const cover = coverOf(project);
const coverUrl = cover ? mediaUrl(project, cover.file) : null;
const mediaBase = `/media/${d.type}/${project.id}/`;

/** B 站视频页链接 → 播放器嵌入链接；无法识别时原样返回。 */
function toEmbed(url?: string): string | null {
  if (!url) return null;
  const bv = url.match(/(BV[0-9A-Za-z]{10})/);
  if (bv) return `https://player.bilibili.com/player.html?bvid=${bv[1]}&page=1&high_quality=1&danmaku=0`;
  const av = url.match(/\/video\/av(\d+)/i);
  if (av) return `https://player.bilibili.com/player.html?aid=${av[1]}&page=1&high_quality=1&danmaku=0`;
  return url;
}

const rawEmbed = toEmbed(d.rawBilibiliUrl);
const finalEmbed = toEmbed(d.bilibiliUrl);

// 组装可切换播放列表：成品区片段（保留全部，含待上传）+ 原片（若有）。
// 成品区空但项目级成片链接存在时兜底补一条，保证仍可放映。
const playables: Playable[] = [];
if (rawEmbed) {
  playables.push({ id: 'raw', label: 'RAW / 原片', kind: 'raw', embed: rawEmbed, thumb: coverUrl, ready: true });
}
for (const c of d.finalClips) {
  const embed = toEmbed(c.bilibiliUrl);
  playables.push({
    id: `clip-${c.label}`,
    label: c.label,
    kind: 'final',
    embed,
    thumb: c.thumb ? `${mediaBase}${c.thumb}` : null,
    ready: !!embed,
  });
}
if (playables.length === 0 && finalEmbed) {
  playables.push({ id: 'final', label: '成片', kind: 'final', embed: finalEmbed, thumb: coverUrl, ready: true });
}

const firstReady = playables.findIndex((p) => p.ready);
const activeIdx = firstReady >= 0 ? firstReady : 0;
const hasScreen = playables.length > 0;
const showSwitcher = playables.length >= 2; // 多视频才出标签条
const isFullWork = d.workKind === '成品片';
---

{
  hasScreen && (
    <section class="block">
      <p class="label en-title">{isFullWork ? 'RAW vs FINAL' : 'SCREENING'}</p>
      <h2 class="title-type">{isFullWork ? '成品放映' : '主片放映'}</h2>

      <div class="sw" data-sw>
        <div class="sw-stage">
          <iframe
            class="sw-frame"
            data-frame
            src={firstReady >= 0 ? playables[firstReady].embed : ''}
            title={`${d.title} 放映`}
            loading="lazy"
            allowfullscreen
            hidden={firstReady < 0}
          ></iframe>
          <div class="sw-ph" data-ph hidden={firstReady >= 0}>
            {coverUrl ? <img src={coverUrl} alt="待上传占位" /> : <span>B 站待上传</span>}
          </div>
        </div>

        {
          showSwitcher && (
            <div class="sw-bar" role="tablist" aria-label="片段切换">
              {playables.map((p, i) => (
                <button
                  class={`sw-tab${i === activeIdx ? ' is-active' : ''}${p.ready ? '' : ' is-pending'}`}
                  data-tab={i}
                  data-embed={p.embed ?? ''}
                  data-ready={p.ready ? '1' : '0'}
                  role="tab"
                  aria-selected={i === activeIdx ? 'true' : 'false'}
                  type="button"
                  disabled={!p.ready}
                >
                  <span class="sw-tab__media">
                    {p.thumb ? (
                      <img src={p.thumb} alt="" loading="lazy" />
                    ) : (
                      <span class="sw-tab__ph" aria-hidden="true"></span>
                    )}
                  </span>
                  <span class="sw-tab__meta">
                    <span class="sw-tab__kind">{p.kind === 'raw' ? 'RAW' : 'FINAL'}</span>
                    <span class="sw-tab__label">{p.label}</span>
                  </span>
                  {!p.ready && <span class="sw-tab__badge">待上传</span>}
                </button>
              ))}
            </div>
          )
        }

      </div>
    </section>
  )
}

{
  showShots && d.shots.length > 0 && (
    <section class="block">
      <p class="label en-title">PRODUCTION BREAKDOWN</p>
      <h2 class="title-type">制作步骤拆解</h2>
      <div class="table-wrap">
        <table class="shot-table">
          <thead>
            <tr><th>#</th><th>景别</th><th>镜头</th><th>运镜</th><th>内容</th><th>功能</th><th>时长</th></tr>
          </thead>
          <tbody>
            {d.shots.map((s) => (
              <tr><td class="mono">{s.id}</td><td>{s.size}</td><td>{s.lens}</td><td>{s.move}</td><td>{s.content}</td><td>{s.function}</td><td class="mono">{s.duration}s</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )
}

<style>
  /* ── 放映区：单播放位 + 可切换标签 ── */
  .sw { margin-top: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }

  .sw-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: #000;
  }
  .sw-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .sw-ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .sw-ph img { width: 100%; height: 100%; object-fit: cover; opacity: 0.42; }
  .sw-ph span {
    position: absolute;
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  /* 标签条：允许换行，保证全部片段可见（不被横向滚动藏住） */
  .sw-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
  .sw-tab {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.5rem 0.6rem;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-media);
    background: var(--surface);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--dur-base) var(--ease), transform var(--dur-base) var(--ease), background var(--dur-base) var(--ease);
  }
  .sw-tab:hover:not(:disabled),
  .sw-tab:focus-visible {
    border-color: var(--accent);
    transform: translateX(3px);
    outline: none;
  }
  .sw-tab.is-active {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
  }
  .sw-tab.is-pending { opacity: 0.55; cursor: not-allowed; }
  .sw-tab__media {
    position: relative;
    flex: 0 0 auto;
    width: 104px;
    aspect-ratio: 16 / 9;
    border-radius: 6px;
    overflow: hidden;
    background: var(--surface-raised);
  }
  .sw-tab__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sw-tab__ph {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--surface-raised), var(--surface));
  }
  .sw-tab__meta { display: flex; flex-direction: column; gap: 0.2rem; min-width: 0; max-width: 16rem; }
  .sw-tab__kind {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    color: var(--accent);
  }
  .sw-tab__label {
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sw-tab__badge {
    align-self: flex-start;
    margin-top: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-pill);
    padding: 0.05rem 0.4rem;
  }

  /* 守卫：本组件给 .sw-frame/.sw-ph 设了 display，会压过 UA 的 [hidden]{display:none}，
     导致隐藏失效（占位层透明叠加在播放器上）。必须显式补回。 */
  .sw-frame[hidden],
  .sw-ph[hidden] {
    display: none !important;
  }

  @media (max-width: 760px) {
    .sw-tab__media { width: 84px; }
    .sw-tab__meta { max-width: 11rem; }
  }
</style>

<script>
  function initSwitcher(root: HTMLElement) {
    if (root.dataset.switcherBound === '1') return;
    const frame = root.querySelector<HTMLIFrameElement>('[data-frame]');
    const ph = root.querySelector<HTMLElement>('[data-ph]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    if (!frame || tabs.length === 0) return;
    root.dataset.switcherBound = '1';

    function select(i: number) {
      const t = tabs[i];
      if (!t || t.disabled) return;
      const ready = t.getAttribute('data-ready') === '1';
      const embed = t.getAttribute('data-embed') || '';
      tabs.forEach((x, j) => {
        const on = i === j;
        x.classList.toggle('is-active', on);
        x.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (ready) {
        ph?.setAttribute('hidden', '');
        frame.removeAttribute('hidden');
        if (embed && frame.getAttribute('src') !== embed) frame.setAttribute('src', embed);
      } else {
        frame.setAttribute('hidden', '');
        ph?.removeAttribute('hidden');
      }
    }

    tabs.forEach((t, i) => t.addEventListener('click', () => select(i)));

    // 同步首屏激活态（服务端已渲染出 activeIdx，客户端再确认一次）
    const init = tabs.findIndex((t) => t.classList.contains('is-active'));
    select(init >= 0 ? init : 0);
  }

  function initSwitchers() {
    document.querySelectorAll<HTMLElement>('[data-sw]').forEach(initSwitcher);
  }

  initSwitchers();
  document.addEventListener('astro:page-load', initSwitchers);
</script>
