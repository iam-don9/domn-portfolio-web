---
// 板块分组（与 skills 板块 sg-head 同形）：
//  - 幽灵描边大字母 A/B/C + 中文分组名 + 英文小标 + 简介
//  - 下方双列极简卡片：封面 + 中英双名 + 简介 + 查看入口（无 highlights/pains）
interface Item {
  href: string;
  coverUrl?: string | null;
  title: string;          // 中文名
  titleEn?: string;       // 英文名
  eyebrow?: string;       // 单行小标（类别 · 年份）
  desc?: string;          // 一句话简介
  flag?: string;          // 角标
  meta?: string[];        // 标签 chips
}
interface Props {
  index: string;          // "A" | "B" | "C"
  label: string;          // 中文分组名
  labelEn: string;        // 英文小标
  intro?: string;         // 分组简介
  items: Item[];
  /** 锚点 id，供侧栏分组头点击滚动定位 */
  id?: string;
}
const { index, label, labelEn, intro, items, id } = Astro.props;
---

<section class="sec-group" id={id}>
  <header class="sg-head">
    <span class="sg-index" aria-hidden="true">{index}</span>
    <div class="sg-titles">
      <h2 class="sg-label">{label}</h2>
      <p class="sg-en">{labelEn}</p>
    </div>
    {intro && <p class="sg-intro">{intro}</p>}
  </header>

  {
    items.length > 0 ? (
      <div class="sg-grid">
        {items.map((it) => (
          <a class="p-card reveal" href={it.href} data-nav-id={it.href}>
            <div class="pc-cover">
              {it.coverUrl ? (
                <img src={it.coverUrl} alt={it.title} loading="lazy" />
              ) : (
                <div class="pc-ph">
                  {it.titleEn && <span class="pc-ph-en">{it.titleEn}</span>}
                  <span class="pc-ph-cn">{it.title}</span>
                </div>
              )}
              {it.flag && <span class="pc-flag">{it.flag}</span>}
            </div>
            <div class="pc-body">
              {it.eyebrow && <p class="pc-eyebrow">{it.eyebrow}</p>}
              <h3 class="pc-name">{it.title}</h3>
              {it.titleEn && <p class="pc-en">{it.titleEn}</p>}
              {it.desc && <p class="pc-desc">{it.desc}</p>}
              {it.meta && it.meta.length > 0 && (
                <ul class="pc-meta">
                  {it.meta.map((m) => <li>{m}</li>)}
                </ul>
              )}
              <span class="pc-cta">VIEW PROJECT <span class="ar">→</span></span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="sg-empty">暂无内容 · 待补充</p>
    )
  }
</section>

<style>
  .sec-group {
    margin-top: clamp(3rem, 7vh, 6rem);
    /* 侧栏分组头点击平滑滚动时，顶部留出顶栏高度，避免被固定顶栏遮挡 */
    scroll-margin-top: calc(var(--topbar-h) + 1rem);
  }
  .sec-group:first-child { margin-top: 0; }

  /* ── 分组头：与 skills 板块 sg-head 同形 ── */
  .sg-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'index titles'
      'index intro';
    column-gap: clamp(1rem, 3vw, 2.4rem);
    align-items: start;
    padding-top: clamp(1.2rem, 3vh, 2rem);
    margin-bottom: clamp(1.6rem, 3.2vh, 2.6rem);
  }
  .sg-index {
    grid-area: index;
    font-family: var(--font-decor);
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    align-self: start;
  }
  .sg-titles { grid-area: titles; }
  .sg-label {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }
  .sg-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
    letter-spacing: 0.18em;
    margin: 0.4rem 0 0;
  }
  .sg-intro {
    grid-area: intro;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0.9rem 0 0;
  }
  .sg-empty {
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px dashed var(--border);
    border-radius: var(--radius-media);
    padding: 1.6rem;
    margin: 0;
  }

  /* ── 项目条目：杂志式大图左右交替（恢复 CaseShowcase 形式），媒体沿用详情页 pp-card 视觉 ── */
  .sg-grid {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 5rem);
  }
  .p-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }
  /* 左右交替：偶数条目媒体在右，奇数在左 */
  .p-card:nth-child(even) .pc-cover { order: 2; }
  .p-card:nth-child(even) .pc-body { order: 1; }

  .pc-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-media);
    background: var(--surface-raised);
    transition: border-color var(--dur-base) var(--ease);
  }
  .p-card:hover .pc-cover { border-color: var(--border); }
  .pc-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pc-ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    background:
      radial-gradient(circle at 28% 18%, var(--accent-dim), transparent 60%),
      linear-gradient(135deg, var(--surface-raised), var(--surface));
  }
  .pc-ph-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pc-ph-cn {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .pc-flag {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 3px 10px;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
  }
  .pc-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pc-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .pc-name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
  }
  .pc-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
    letter-spacing: 0.06em;
    margin: 0;
  }
  .pc-desc {
    font-size: var(--fs-small);
    line-height: 1.68;
    color: var(--text-secondary);
    margin: 0;
  }
  .pc-meta {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .pc-meta li {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: var(--radius-chip);
    padding: 4px 9px;
  }
  .pc-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease), gap var(--dur-fast) var(--ease);
  }
  .p-card:hover .pc-cta {
    color: var(--accent);
    gap: 0.7rem;
  }

  /* 滚动浮现 */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
  }
  .reveal.in { opacity: 1; transform: none; }

  @media (max-width: 820px) {
    .sg-head {
      grid-template-columns: 1fr;
      grid-template-areas:
        'index'
        'titles'
        'intro';
    }
    .sg-index { font-size: 3rem; }
    .sg-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function initGroupReveal() {
    const els = document.querySelectorAll('.sec-group .reveal:not(.in)');
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
  initGroupReveal();
  document.addEventListener('astro:page-load', initGroupReveal);
</script>
