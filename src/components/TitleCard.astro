---
// 子页标题卡片（横幅式）：
//  - 纯黑、无边框，全出血横跨视口（上贴导航栏底、左右贴网页边界）
//  - 视频铺满整张卡片作背景，靠右上对齐（右置·上置）
//  - 标题叠加在左侧半透明层上
interface Props {
  num: string;
  label: string;       // 英文主标签，如 WORLDBUILDING
  labelCn: string;     // 中文副标签
  title: string;       // 页面主标题
  lede?: string;       // 导语（可省略）
  video: string;       // 该板块背景视频（相对 public/ 路径）
}
const { num, label, labelCn, title, lede, video } = Astro.props;
---

<section class="title-card">
  <video
    class="tc-video"
    src={video}
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    aria-hidden="true"
  ></video>
  <div class="tc-scrim" aria-hidden="true"></div>
  <a class="back-link" href="/">← BACK TO HOME / 返回首页</a>
  <div class="tc-content">
    <p class="page-eyebrow">{num} / {labelCn}</p>
    <h1 class="page-title">{title}</h1>
    {lede && <p class="page-lede">{lede}</p>}
  </div>
</section>

<style>
  .title-card {
    position: sticky;            /* 英雄区固定，不随滚动移动 */
    top: var(--topbar-h);        /* 停在导航栏下方 */
    z-index: 22;                 /* 高于下方内容(page-body z21)，低于导航栏 z30；滚动时项目内容在其背后，不会盖住英雄区 */
    /* 四板块统一高度 */
    height: clamp(320px, 44vh, 460px);
    margin-top: 0;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    background: #000;            /* 纯黑 */
    border: none;                                      /* 不要四周边框 */
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);  /* 仅底部浅色线，无圆角 */
    border-radius: 0;                                      /* 直角 */
    /* 黑色阴影：纯黑页面上黑叠黑不可见，仅保留语义（如日后页面背景变亮即生效） */
    box-shadow: 0 50px 90px -30px rgba(0, 0, 0, 0.9);
    overflow: hidden;
  }

  /* 视频缩放：短边 = 卡片短边（横幅卡片短边 = 高度），右置上置，其余留纯黑 */
  .tc-video {
    position: absolute;
    top: 0;
    right: 0;
    height: 100%;
    aspect-ratio: 16 / 9;   /* 与素材原始比例一致 → 不裁切不变形 */
    width: auto;
    object-fit: cover;
    background: #000;
  }

  /* 左侧半透明层：承载标题，向右渐隐透出视频 */
  .tc-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(0, 0, 0, 0.88) 0%,
      rgba(0, 0, 0, 0.66) 38%,
      rgba(0, 0, 0, 0.22) 70%,
      rgba(0, 0, 0, 0) 100%
    );
  }

  /* 标题内容：左侧，浮于视频与遮罩之上 */
  .tc-content {
    position: relative;
    z-index: 2;
    width: min(100%, 54%);
    min-height: inherit;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.75rem, 1.6vw, 1.4rem);
    padding: clamp(1.5rem, 4vw, 3.5rem) clamp(1.5rem, 4vw, 4.5rem);
  }
  .tc-content .page-title { text-shadow: 0 2px 18px rgba(0, 0, 0, 0.5); }
  .tc-content .page-lede { text-shadow: 0 1px 10px rgba(0, 0, 0, 0.5); }

  /* 返回链接：卡片内左上角，浮于视频之上 */
  .title-card .back-link {
    position: absolute;
    top: clamp(0.9rem, 2vh, 1.4rem);
    left: clamp(1.5rem, 4vw, 4.5rem);
    z-index: 3;
    margin: 0;
  }

  @media (max-width: 820px) {
    .tc-content { width: 100%; }
    .tc-scrim {
      background: linear-gradient(
        to top,
        rgba(0, 0, 0, 0.92) 0%,
        rgba(0, 0, 0, 0.55) 58%,
        rgba(0, 0, 0, 0.28) 100%
      );
    }
  }
</style>
