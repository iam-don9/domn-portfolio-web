---
// 首页「代表作品 / SELECTED WORKS」——整屏大版面斜向分割（Neo-Brutalism）
// 三块色面从视口顶铺到底，斜边咬合成 [<< 的左重右轻节奏；编号 01/02/03 作为版面水印。
// 默认态是纯色面 + 作品名，hover 时封面（着色器）从色面下渐显——克制揭示。
// 字阶锁 3 级（--fs-h2 / --fs-h3 / --fs-label）；动效安静（错峰淡入 + 微提亮）。
const works = [
  {
    n: '01',
    t: '进化论：牧狼人',
    tEn: 'EVOLUTION',
    cat: '3D CGI',
    genre: '暗黑奇幻 · 末世',
    year: 2026,
    status: '进行中',
    cover: '/media/ai-video/evolution-wolf-herder/e0-cover.webp',
    href: '/films/evolution-wolf-herder',
    accent: true,
    tint: '#00b894',
  },
  {
    n: '02',
    t: '雨巷',
    tEn: 'RAIN ALLEY',
    cat: 'LIVE-ACTION',
    genre: '民国 · 动作',
    year: 2026,
    status: '完成',
    cover: '/media/ai-video/rain-alley/cover.webp',
    href: '/films/rain-alley',
    accent: false,
    tint: '#00b894',
  },
  {
    n: '03',
    t: '十二大战',
    tEn: 'ZODIAC WAR',
    cat: '2D ANIME',
    genre: '东方奇幻 · 角色演出',
    year: 2026,
    status: '完成',
    cover: '/media/character-design/zodiac-war/cover.webp',
    href: '/films/zodiac-war',
    accent: false,
    tint: '#00b894',
  },
];
---

<section class="sw-bleed reveal" id="selected-works">
  <div class="sw-slabs">
    {works.map((w, i) => (
      <a
        class={`sw-pane sw-pane--${w.accent ? 'accent' : i === 1 ? 'mid' : 'deep'} reveal`}
        href={w.href}
        style={`--i:${i}`}
      >
        <span class="sw-ghost" aria-hidden="true">{w.n}</span>
        <div class="sw-pane__media">
          <img src={w.cover} alt={w.t} loading="lazy" decoding="async" />
          <canvas data-shader-cover data-src={w.cover} data-tint={w.tint}></canvas>
        </div>
        <div class="sw-pane__body">
          <span class="sw-pane__num">{w.n} / {w.cat}</span>
          <h3 class="sw-name">{w.t}</h3>
          <p class="sw-meta">{w.genre} · {w.year}{w.status === '进行中' ? ' · 进行中' : ''}</p>
          <span class="sw-go">查看作品 ↗</span>
        </div>
      </a>
    ))}
  </div>

  <header class="sw-head">
    <h2 class="sw-title">代表作品<span class="sw-title-en">SELECTED WORKS</span></h2>
  </header>
</section>

<script>
  import '../scripts/worksShader.mjs';
</script>

<style>
  /* ── 满版容器：整屏铺满，斜切成三块色面 ── */
  .sw-bleed {
    position: relative;
    width: 100%;
    min-height: 100%;                                     /* 铺满 S5 整屏（父级 slide-inner--bleed 已 100%） */
    overflow: hidden;
    background: transparent;                              /* 透出底层生成式氛围层（色面覆盖处仍不露） */
  }

  .sw-slabs {
    position: absolute; left: 0; right: 0; top: var(--topbar-h); bottom: 0;
    --cut: 5.5vw; /* 斜边水平位移量：三块斜切咬合的唯一参数 */
  }

  /* 斜切咬合：顶边比底边右移 6vw，分界线自上而下向右倾（\） */
  .sw-pane {
    position: absolute;
    top: 0; bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: clamp(1.6rem, 4vh, 3rem) clamp(1.8rem, 3vw, 3.4rem);
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    transition: filter var(--dur-base, 320ms) var(--ease);
  }
  .sw-pane:hover { filter: brightness(1.07); }

  /* 咬合几何：每块 width = 视觉宽 + cut，left 按视觉宽累进（40% / 32% / 28%）。
     只有前两块自己切右斜边，第三块保持矩形——它的左上三角由第二块的斜边盖住，
     这样最窄的右块底部能留出完整的文字宽度，不会被斜边压到换行。
     z-index 逐块递减：前块压住后块的左三角。 */
  .sw-pane:nth-child(1) {
    left: 0; width: calc(40% + var(--cut)); z-index: 3;
    padding-left: clamp(2rem, 3.2vw, 4rem);
    padding-bottom: clamp(2.4rem, 7vh, 4.6rem);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% 100%, 0 100%);
  }
  .sw-pane:nth-child(2) {
    left: 40%; width: calc(32% + var(--cut)); z-index: 2;
    padding-left: calc(var(--cut) + clamp(2rem, 3vw, 3.6rem));
    padding-right: clamp(1.8rem, 2.6vw, 3rem);
    padding-bottom: clamp(2.4rem, 7vh, 4.6rem);
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% 100%, 0 100%);
  }
  .sw-pane:nth-child(3) {
    left: 72%; right: 0; z-index: 1;
    /* 文字仍要避开被第二块斜边盖住的左下三角 */
    padding-left: calc(var(--cut) + clamp(1rem, 1.4vw, 1.8rem));
    padding-right: clamp(2rem, 3.2vw, 4rem);
    padding-bottom: clamp(2.4rem, 7vh, 4.6rem);
  }

  /* 色面：强调绿（左重）→ 中性中调 → 深调 */
  .sw-pane--accent { background: var(--accent); color: #06120f; }
  .sw-pane--mid { background: color-mix(in srgb, var(--bg) 76%, var(--white) 24%); color: var(--text-primary); }
  .sw-pane--deep { background: color-mix(in srgb, var(--bg) 92%, var(--white) 8%); color: var(--text-primary); }

  /* ── 版面水印编号：超大、描边，压在色面上 ── */
  .sw-ghost {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    top: 17%;              /* 上中安全区：避开左下作品名，也避开屏头 */
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 9vw, 8rem);
    line-height: 0.78;
    letter-spacing: -0.02em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.22);
    pointer-events: none;
    user-select: none;
  }
  .sw-pane--accent .sw-ghost { -webkit-text-stroke: 1.5px rgba(6, 18, 15, 0.34); }

  /* ── 封面 / 着色器：默认藏在色面下，hover 渐显 ── */
  .sw-pane__media { position: absolute; inset: 0; pointer-events: none; }
  .sw-pane__media img,
  .sw-pane__media canvas {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; display: block;
    opacity: 0; transition: opacity var(--dur-base, 320ms) var(--ease);
  }
  .sw-pane__media::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.78), rgba(0, 0, 0, 0.15) 55%, transparent);
    opacity: 0; transition: opacity var(--dur-base, 320ms) var(--ease);
  }
  .sw-pane:hover .sw-pane__media img,
  .sw-pane:hover .sw-pane__media canvas { opacity: 0.6; }
  .sw-pane:hover .sw-pane__media::after { opacity: 1; }

  /* ── 文字层 ── */
  .sw-pane__body { position: relative; z-index: 2; display: flex; flex-direction: column; gap: 0.4rem; }
  .sw-pane__num {
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.72;
  }
  .sw-name {
    margin: 0;
    font-family: var(--font-cn-head); font-weight: 400;   /* LogoSC 仅 400 单字重，禁止合成加粗 */
    font-size: var(--fs-h2); line-height: 1.08;
    letter-spacing: 0;
  }
  .sw-meta {
    margin: 0;
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.05em; opacity: 0.8;
  }
  .sw-go {
    margin-top: 0.55rem; align-self: flex-start;
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.08em;
    color: currentColor; opacity: 0.65;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity var(--dur-fast, 180ms) var(--ease);
  }
  .sw-pane--accent .sw-go { color: #06120f; }
  .sw-pane:hover .sw-go { opacity: 1; color: #fff; }

  /* ── 屏头：压在左侧绿面顶部 ── */
  .sw-head {
    position: absolute;
    left: clamp(1.6rem, 3vw, 3.4rem);
    top: calc(var(--topbar-h) + clamp(1.4rem, 4vh, 2.8rem));
    z-index: 3;
    max-width: min(30vw, 22rem);
    color: #06120f;
  }
  .sw-kicker {
    display: block;
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.14em; text-transform: uppercase;
    opacity: 0.72; margin: 0 0 0.45rem;
  }
  .sw-title {
    margin: 0;
    font-family: var(--font-cn-head); font-weight: 400;   /* LogoSC 仅 400 单字重，禁止合成加粗 */
    font-size: var(--fs-h1); line-height: 1.04;
  }
  .sw-title-en {
    display: block;
    font-family: var(--font-mono); font-weight: 400; font-size: 0.42em;
    letter-spacing: 0.2em; text-transform: uppercase;
    margin-top: 0.35rem; opacity: 0.66;
  }

  /* 逐块错峰淡入（安静） */
  .sw-pane.reveal { transition-delay: calc(var(--i, 0) * 0.08s); }

  /* ── 窄屏：退回纵向堆叠（斜切在小宽度上会压字） ── */
  @media (max-width: 900px) {
    .sw-slabs { display: flex; flex-direction: column; }
    .sw-pane,
    .sw-pane:nth-child(1),
    .sw-pane:nth-child(2),
    .sw-pane:nth-child(3) {
      position: relative;
      left: auto; right: auto; width: auto; z-index: auto;
      flex: 1 1 0; min-height: 0;
      clip-path: none;
      padding: 1.2rem clamp(1.2rem, 4vw, 2rem);
      justify-content: flex-end;
    }
    .sw-ghost { font-size: clamp(2.4rem, 9vw, 4rem); top: 6%; }
    .sw-head {
      position: relative; left: auto;
      top: auto; max-width: none;
      order: -1;                     /* 纵向堆叠时屏头回到最顶 */
      padding: calc(var(--topbar-h) + 0.9rem) clamp(1.2rem, 4vw, 2rem) 0;
      color: var(--text-primary);
    }
    .sw-bleed { display: flex; flex-direction: column; }
    .sw-slabs { position: relative; inset: auto; flex: 1; min-height: 0; }
  }
</style>
