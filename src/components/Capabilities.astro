---
import { SKILL_DECKS } from '../data/skillSlides';
/*
 * S5 · 我做什么 / WHAT I DO（03 号屏）
 * 信息主线：左=六步交付管线（核心叙事，AI 视频导演怎么把活干完），右=方法论 + 新兴创作方法。
 * 打破等宽三栏，让「管线」成为视觉主导，右侧两块收为次级。
 */
const steps = [
  { n: '01', stage: '剧本', title: '双轨时间线剧本', note: '画面轨＋声音轨＋规格规范，一稿可复现' },
  { n: '02', stage: '资产', title: '9 角色 + 4 场景', note: '解剖学约束表量化兽化率，先锁型' },
  { n: '03', stage: '生成', title: 'Seedance 2.5 跑通', note: '近身兵刃交锋 + 四米体量差验证' },
  { n: '04', stage: '迭代', title: '修粘连 · 重写力学', note: '武器粘连改格挡角，倒飞按抛物线重写' },
  { n: '05', stage: '剪辑', title: '主视觉 + 设定总表', note: '从成片段落反推海报，跨镜一致性校对' },
  { n: '06', stage: '声音', title: '四轨混音时序', note: '对白 / 音乐 / 音效 / 环境逐段对齐' },
];
const skills = [
  { en: 'domn-film-screenplay-save-the-cat', name: '剧本结构 · Save the Cat', idea: '先锁节拍再写提示词，情绪曲线驱动分镜' },
  { en: 'domn-film-action-director', name: '动作导演', idea: '武打拆成明确掠过点，规避 AI 环摇死穴' },
  { en: 'domn-film-character-showcase', name: '角色展示 · 一致性', idea: '解剖学约束表量化兽化率，生成不漂' },
  { en: 'domn-cover', name: '封面生成', idea: '从成片段落反推单帧主视觉，复用传播' },
  { en: 'domn-film-style-deconstruct', name: '风格解构', idea: '把参考片拆成可复用镜头语言与光比' },
  { en: 'domn-film-seedance-format', name: 'Seedance 格式', idea: '用生成单元 GU 固化镜头规范与画幅' },
];
const methods = [
  { en: 'WHITE-MODEL', k: '白模预演', desc: '用白模 / 简单体块先锁构图、调度与机位，再喂生成，把漂移扼杀在分镜阶段。' },
  { en: 'DIRECTOR DESK', k: '导演台 / 导播台', desc: '像导播台一样实时操控角色、机位、光比，把生成当多机位现场，批量出镜。' },
  { en: 'AGENT-ASSIST', k: 'Coding Agent 辅助', desc: '用 coding agent 生成约束表、批量镜头提示词、自动化一致性校验。' },
];
---

<section class="slide cap-slide" id="what-i-do">
  <div class="cap-inner reveal">
    <!-- 屏头：编号 + 标题 -->
    <header class="cap-head">
      <span class="cap-num" aria-hidden="true">02</span>
      <div class="cap-head__t">
        <h2 class="cap-title">我做什么</h2>
      </div>
    </header>

    <!-- 信息主线：一句话点明「把创作工程化」 -->
    <p class="cap-thesis">从剧本到混音的一条龙交付——把创作拆成可复现的工程步骤。</p>

    <div class="cap-grid">
      <!-- 左：交付管线（核心叙事，视觉主导） -->
      <article class="cap-pipeline">
        <p class="cap-block__k">AI VIDEO DIRECTOR · 交付管线</p>
        <ol class="cap-steps">
          {steps.map((s) => (
            <li class="step">
              <span class="step__no">{s.n}</span>
              <div class="step__bd">
                <p class="step__t">{s.stage} · {s.title}</p>
                <p class="step__note">{s.note}</p>
              </div>
            </li>
          ))}
        </ol>
      </article>

      <!-- 右：方法论 + 创作方法（次级） -->
      <div class="cap-side">
        <article class="cap-block">
          <p class="cap-block__k">CREATIVE TOOLKIT · 创作方法论</p>
          <ul class="cap-skills">
            {skills.map((s) => (
              <li class="skill">
                <a class="skill__link" href={SKILL_DECKS[s.en] ?? `/slides/${s.en}.html`}>
                  <p class="skill__name">{s.name}</p>
                  <p class="skill__idea">{s.idea}</p>
                </a>
              </li>
            ))}
          </ul>
        </article>

        <article class="cap-block">
          <p class="cap-block__k">NEW WORKFLOWS · 新兴创作方法</p>
          <ul class="cap-methods">
            {methods.map((m) => (
              <li class="method">
                <p class="method__en">{m.en}</p>
                <p class="method__k">{m.k}</p>
                <p class="method__desc">{m.desc}</p>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </div>
</section>

<style>
  .cap-slide {
    position: relative;
    height: 100dvh;                    /* S4：整页竖向滑页，严格满屏（一屏=一板块） */
    min-height: 100dvh;
    overflow: hidden;                  /* 面板本身只一屏；内容超出在 .cap-inner 内部滚动 */
    display: flex;
    flex-direction: column;
    background: transparent;           /* 透出底层生成式氛围层 */
  }
  .cap-inner {
    flex: 1; min-height: 0;
    width: min(100%, var(--content-w));
    max-width: var(--content-max);
    margin-inline: auto;
    display: flex; flex-direction: column;
    padding: calc(var(--topbar-h) + clamp(0.8rem, 2vh, 1.6rem)) clamp(1.5rem, 4vw, 4.5rem) clamp(1.4rem, 3vh, 2.4rem);
    overflow-y: auto; overflow-x: hidden;   /* 内容超出一屏时在面板内滚动，不撑高板块 */
    scrollbar-width: none;
  }
  .cap-inner::-webkit-scrollbar { width: 0; height: 0; display: none; }

  /* ── 屏头（与 S3 解耦：无绿脊线，巨型编号作锚点）── */
  .cap-head {
    position: relative;
    flex: 0 0 auto;
    display: flex; align-items: flex-end; gap: 1.1rem;
    padding-bottom: 0.4rem; margin-bottom: clamp(1rem, 2.4vh, 1.8rem);
  }
  .cap-num {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    line-height: 0.9;
    color: transparent;
    -webkit-text-stroke: 1px var(--accent);
  }
  .cap-title {
    font-family: var(--font-cn-head); font-weight: 400;   /* LogoSC 仅 400 单字重，禁止合成加粗 */
    font-size: var(--fs-h2);
    line-height: 1.1; margin: 0;
    text-wrap: balance;
  }

  /* ── 信息主线 ── */
  .cap-thesis {
    position: relative;
    flex: 0 0 auto;
    font-size: clamp(1.05rem, 1.7vw, 1.4rem);
    line-height: 1.5; color: var(--text-secondary);
    max-width: var(--measure-wide);
    margin: 0 0 clamp(1.2rem, 3vh, 2rem);
  }

  /* ── 单栏纵向管线（与 S3 双栏解耦）：管线主导，底部 skills/methods 双栏 ── */
  .cap-grid {
    flex: 1; min-height: 0;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: clamp(1.6rem, 3.4vh, 3rem);
    align-items: start;
  }
  .cap-block__k {
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--text-muted); margin: 0 0 0.85rem;
  }
  /* 顶部强调线：去卡片盒 → 排版块（与全站屏头节奏呼应） */
  .cap-pipeline, .cap-block {
    min-width: 0;
    display: flex; flex-direction: column;
    border-top: 2px solid var(--accent);
    padding-top: 1rem;
  }
  .cap-side {
    min-width: 0;
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1.6rem, 3.4vw, 3.4rem);
  }

  /* A · 交付管线（六步）：巨型编号作纵向纪念碑脊柱 */
  .cap-steps { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; }
  .step { display: flex; align-items: baseline; gap: clamp(0.8rem, 1.6vw, 1.4rem); padding: clamp(0.5rem, 1.1vh, 0.9rem) 0; }
  .step + .step { border-top: 1px solid var(--border-soft, var(--border)); }
  .step__no {
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 4.6vw, 3.6rem);
    line-height: 0.9;
    color: transparent; -webkit-text-stroke: 1.4px var(--accent);
    flex: 0 0 auto; width: clamp(2.6rem, 5vw, 4.2rem);
  }
  .step__t { margin: 0; font-weight: 400; font-size: clamp(0.95rem, 1.3vw, 1.15rem); line-height: 1.3; }
  .step__note {
    margin: 0.1rem 0 0; font-size: var(--fs-label); line-height: 1.4;
    color: var(--text-muted);
  }

  /* B · skill 列表 */
  .cap-skills { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; }
  .skill + .skill { border-top: 1px solid var(--border-soft, var(--border)); }
  .skill__link { display: block; padding: 0.48rem 0; text-decoration: none; }
  .skill__name { margin: 0; font-weight: 600; font-size: 0.88rem; line-height: 1.3; transition: color var(--dur-fast) var(--ease); }
  .skill__link:hover .skill__name { color: var(--accent-strong); }
  .skill__idea {
    margin: 0.1rem 0 0; font-size: var(--fs-label); line-height: 1.4; color: var(--text-muted);
  }

  /* C · 创作方法 */
  .cap-methods { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; }
  .method { padding: 0.55rem 0; }
  .method + .method { border-top: 1px solid var(--border-soft, var(--border)); }
  .method__en {
    font-family: var(--font-mono); font-size: var(--fs-label);
    letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--accent-strong); margin: 0 0 0.2rem;
  }
  .method__k { margin: 0; font-family: var(--font-cn-head); font-weight: 400; font-size: 0.95rem; line-height: 1.25; }
  .method__desc { margin: 0.2rem 0 0; font-size: var(--fs-label); line-height: 1.5; color: var(--text-muted); }

  @media (max-width: 960px) {
    .cap-side { grid-template-columns: 1fr; }
    .cap-pipeline { min-height: 0; }
  }
</style>
