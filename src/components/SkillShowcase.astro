---
interface Skill {
  name: string;
  en: string;
  desc: string;
  highlights?: string[];
  pains?: string[];
  cover?: string;
  /** 有详情页时提供（如集合工具卡）→ 整卡变链接；缺省维持演示卡行为 */
  href?: string;
  /** GitHub 源码地址 → 渲染在卡片右下角，独立于「查看演示」的点击 */
  github?: string;
}
interface Category {
  label: string;
  en: string;
  intro: string;
  skills: Skill[];
}
interface Props {
  categories: Category[];
}
const { categories } = Astro.props;
---

<section class="skill-deck">
  {
    categories.map((cat, ci) => (
      <div class="skill-group" id={`skill-${String.fromCharCode(65 + ci)}`}>
        <header class="sg-head">
          <span class="sg-index" aria-hidden="true">{String.fromCharCode(65 + ci)}</span>
          <div class="sg-titles">
            <h2 class="sg-label">{cat.label}</h2>
            <p class="sg-en">{cat.en}</p>
          </div>
          <p class="sg-intro">{cat.intro}</p>
        </header>

        <div class="sg-grid">
          {cat.skills.map((s) => {
            const Tag = (s.href ? 'a' : 'article') as 'a' | 'article';
            return (
              <Tag
                class="skill-card reveal"
                data-skill={s.href ? undefined : s.en}
                data-nav-id={s.en}
                href={s.href}
                role={s.href ? undefined : 'button'}
                tabindex={s.href ? undefined : 0}
                aria-label={s.href ? `查看 ${s.name} 详情` : `查看 ${s.name} 演示`}
              >
                <div class="sc-cover">
                  {s.cover ? (
                    <img src={s.cover} alt={s.name} loading="lazy" />
                  ) : (
                    <div class="sc-cover-ph">
                      <span class="sc-cp-cat">{cat.label}</span>
                      <span class="sc-cp-name">{s.name}</span>
                      <span class="sc-cp-en">{s.en}</span>
                    </div>
                  )}
                </div>
                <div class="sc-head">
                  <h3 class="sc-name">{s.name}</h3>
                  <code class="sc-en">{s.en}</code>
                </div>
                <p class="sc-desc">{s.desc}</p>

                {s.highlights && s.highlights.length > 0 && (
                  <div class="sc-block">
                    <p class="sc-block-label sc-hl">亮点 · HIGHLIGHTS</p>
                    <ul class="sc-list sc-list-hl">
                      {s.highlights.map((h) => <li>{h}</li>)}
                    </ul>
                  </div>
                )}

                {s.pains && s.pains.length > 0 && (
                  <div class="sc-block">
                    <p class="sc-block-label sc-pain">解决痛点 · PAIN POINTS</p>
                    <ul class="sc-list sc-list-pain">
                      {s.pains.map((p) => <li>{p}</li>)}
                    </ul>
                  </div>
                )}

                <div class="sc-foot-row">
                  <span class="sc-foot">{s.href ? '查看详情' : '查看演示'} <span class="sc-ar">→</span></span>
                  {s.github && (
                    <a
                      class="sc-gh"
                      href={s.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`在 GitHub 查看 ${s.en}`}
                    >
                      GitHub <span class="sc-ar">↗</span>
                    </a>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    ))
  }
</section>

<style>
  .skill-deck {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 7vh, 6rem);
  }

  /* 侧栏分组头点击平滑滚动时，顶部留出顶栏高度，避免被固定顶栏遮挡 */
  .skill-group {
    scroll-margin-top: calc(var(--topbar-h) + 1rem);
  }

  .sg-head {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'index titles'
      'index intro';
    column-gap: clamp(1rem, 3vw, 2.4rem);
    align-items: start;
    padding-top: clamp(1.2rem, 3vh, 2rem);
    margin-bottom: clamp(1.6rem, 3.2vh, 2.6rem);
  }
  .sg-index {
    grid-area: index;
    font-family: var(--font-decor);
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 0.78;
    color: transparent;
    -webkit-text-stroke: 1px var(--border);
    align-self: start;
  }
  .sg-titles { grid-area: titles; }
  .sg-label {
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--text-primary);
  }
  .sg-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
    letter-spacing: 0.18em;
    margin: 0.4rem 0 0;
  }
  .sg-intro {
    grid-area: intro;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--text-muted);
    margin: 0.9rem 0 0;
  }

  .sg-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.6rem);
  }

  .skill-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-media);
    padding: clamp(1.2rem, 2.4vw, 1.8rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    cursor: pointer;
    transition: transform var(--dur-slow) var(--ease), border-color var(--dur-base) var(--ease);
  }
  .skill-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }

  .sc-cover {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--surface-raised);
  }
  .sc-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sc-cover-ph {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.3rem;
    padding: 1rem 1.2rem;
    background:
      radial-gradient(circle at 28% 18%, var(--accent-dim), transparent 60%),
      linear-gradient(135deg, var(--surface-raised), var(--surface));
  }
  .sc-cp-cat {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .sc-cp-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }
  .sc-cp-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
    letter-spacing: 0.06em;
  }

  .sc-foot-row {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .sc-foot {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    transition: color var(--dur-fast) var(--ease), gap var(--dur-fast) var(--ease);
  }
  .skill-card:hover .sc-foot {
    color: var(--accent);
    gap: 0.7rem;
  }
  .sc-gh {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    padding: 5px 11px;
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .sc-gh:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .sc-head {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .sc-name {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    letter-spacing: -0.01em;
    margin: 0;
    color: var(--text-primary);
  }
  .sc-en {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--accent);
    letter-spacing: 0.08em;
  }
  .sc-desc {
    font-size: var(--fs-small);
    line-height: 1.68;
    color: var(--text-secondary);
    margin: 0;
  }

  .sc-block {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-soft);
  }
  .sc-block-label {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin: 0;
  }
  .sc-hl { color: var(--accent); }
  .sc-pain { color: #c98a7d; }

  .sc-list {
    margin: 0;
    padding-left: 1.05rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .sc-list li {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--text-muted);
  }
  .sc-list-hl li::marker { color: var(--accent-dim); }
  .sc-list-pain li::marker { color: #c98a7d; }

  /* 滚动浮现 */
  .reveal {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);
  }
  .reveal.in {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 820px) {
    .sg-head {
      grid-template-columns: 1fr;
      grid-template-areas:
        'index'
        'titles'
        'intro';
    }
    .sg-index { font-size: 3rem; }
    .sg-grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  function initSkillReveal() {
    const els = document.querySelectorAll('.skill-deck .reveal:not(.in)');
    if (!els.length) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    els.forEach((el) => io.observe(el));
  }
  initSkillReveal();
  document.addEventListener('astro:page-load', initSkillReveal);
</script>
